# Shared password for the Learning Bridge+ (Cox's Bazar) / NRC section of the site.
# Set this in Vercel (Project Settings → Environment Variables) for Production and Preview, and
# locally in .env.local. If it is unset, that section is inaccessible in production (fail closed)
# and open in local development.
#
# It is a single shared secret handed to NRC and Amala colleagues — make it long, and change it
# by editing this variable and redeploying (which invalidates everyone's existing unlock).
LB_NRC_PASSWORD=

# ---- Sign-in (Auth.js + Google) ----
# The whole site sits behind Google sign-in. Amala Workspace accounts are admitted by their `hd`
# claim; everyone else needs a record in the Firestore `authorised_users` collection, managed at
# /admin. See lib/authorised-users.ts.

# Signs the session cookie. Generate with `openssl rand -base64 32`. Changing it signs everyone out.
AUTH_SECRET=

# OAuth 2.0 Web application client, created in the Google Cloud console for the hosting project.
# Authorised redirect URI: https://<your-host>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated. These addresses are always superadmin, whatever the allowlist says - the way
# back in if the allowlist is ever empty or unreachable.
SUPERADMIN_EMAILS=louie@amalaeducation.org
